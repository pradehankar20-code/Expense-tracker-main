      "url": "./index.html?action=scan_qr",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Upload UPI Receipt",
      "short_name": "Receipt OCR",
      "description": "Upload a payment screenshot from PhonePe/GPay",
      "url": "./index.html?action=scan_receipt",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Add Expense",
      "short_name": "Add",
      "description": "Record a new expense entry",
      "url": "./index.html?action=add_tx",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    }
  ]
